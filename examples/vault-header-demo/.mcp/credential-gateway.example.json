{
  "listen": {"host": "0.0.0.0", "port": 8090},
  "authorization_server": {"issuer": "https://auth.example.com/mcp-auth"},
  "session_binding_key_file": "/run/secrets/gateway-session-binding",
  "mappings_file": "/etc/mcp-auth/private-mappings.json",
  "provider": {
    "type": "onepassword",
    "options": {
      "mode": "service_account",
      "service_account_token_file": "/run/secrets/onepassword-service-account",
      "timeout_seconds": 30
    }
  },
  "credential_cache": {"ttl_seconds": 300, "max_entries": 1024},
  "services": [{
    "id": "vault-header-demo",
    "resource_url": "https://credentials.example.com/vault-header-demo/mcp",
    "upstream_url": "https://mcp.example.com/vault-header-demo/mcp",
    "validation_url": "https://mcp.example.com/vault-header-demo/mcp/auth/check",
    "required_scopes": ["tools:read"],
    "resource_client": {
      "client_id": "vault-header-demo-gateway",
      "key_id": "gateway-1",
      "private_key_file": "/run/secrets/vault-header-demo-client.pem"
    },
    "headers": [{"name": "Authorization", "type": "basic", "username_field": "username", "password_field": "password"}]
  }]
}
