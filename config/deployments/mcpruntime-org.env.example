# MCP Runtime — k3s public deployment (mcpruntime.org)
#
# Copy to mcpruntime-org.env (same directory) and fill in real values.
# mcpruntime-org.env is gitignored; keep secrets out of this file.
#
# All variables below map 1-to-1 to a `mcp-runtime setup` flag so that
# the full setup can be driven with just:
#
#   bin/mcp-runtime setup --env-file config/deployments/mcpruntime-org.env
#
# Full variable reference: docs/k3s-deployment-runbook.md#environment-variable-reference
#
# Other scripts that consume this file:
#   hack/deploy/mcpruntime-org/setup.sh
#   hack/deploy/mcpruntime-org/clean.sh --yes --wait
#   hack/deploy/mcpruntime-org/restore.sh
#   hack/deploy/mcpruntime-org/rollout.sh
#
# Override profile path: MCP_DEPLOY_ENV=/path/to/other.env

# ---------------------------------------------------------------------------
# Cluster access  (--kubeconfig / --context)
# ---------------------------------------------------------------------------
# Use the shared kubeconfig and select the production context with kubectl.
# Use a provider-issued kubeconfig or a secure copy from the k3s server; see
# docs/k3s-deployment-runbook.md#obtain-and-select-cluster-access.
# Defaults to the KUBECONFIG selected in your shell or ~/.kube/config.
export MCP_SETUP_KUBECONFIG="${KUBECONFIG:-${HOME}/.kube/config}"
# Production VM SSH host; use SSH key authentication and never store its password here.
export MCP_PRODUCTION_SSH_HOST=your-production-vm.example.com
# Optional; selects a named context when the kubeconfig contains multiple clusters.
# export MCP_KUBE_CONTEXT=<context-name>

# ---------------------------------------------------------------------------
# Public platform hostnames
# registry.<domain>, mcp.<domain>, platform.<domain> are derived automatically.
# ---------------------------------------------------------------------------
export MCP_PLATFORM_DOMAIN=mcpruntime.org

# Internal pod pulls MUST use the TLS-covered registry hostname (not a ClusterIP).
# Keep this set: when it is unset and equals the ingress host, setup resolves
# the internal endpoint to the registry ClusterIP instead.
export MCP_REGISTRY_ENDPOINT=registry.mcpruntime.org
# export MCP_REGISTRY_INGRESS_HOST=registry.mcpruntime.org   # optional; derived from MCP_PLATFORM_DOMAIN

# Workstation builds Linux images; k3s nodes on this cluster are amd64.
export MCP_IMAGE_PLATFORM=linux/amd64
# Host-facing Kubernetes API port used by the runtime API NetworkPolicy.
# k3s defaults to 6443; change this for clusters with a different API port.
export MCP_KUBERNETES_API_PORT=6443
# Optional portability overrides. Setup discovers common defaults when unset.
# export MCP_CLUSTER_DOMAIN=cluster.local
# export MCP_DNS_LABEL_KEY=k8s-app
# export MCP_DNS_LABEL_VALUE=kube-dns
# export MCP_STORAGE_CLASS=local-path
# export MCP_DEFAULT_INGRESS_CLASS=traefik
# export MCP_DEFAULT_INGRESS_ENTRYPOINTS=web
# Optional image used by cluster doctor smoke tests. Set this to an image in
# an internal registry for air-gapped or restricted clusters.
# export MCP_DOCTOR_SMOKE_IMAGE=registry.example.com/platform/doctor-smoke:latest

# Required for non-test-mode setup validation (platform admin bootstrap).
export MCP_PLATFORM_ADMIN_EMAIL=admin@example.com
# export MCP_PLATFORM_ADMIN_PASSWORD='<from-password-manager>'

# ---------------------------------------------------------------------------
# Registry  (--registry-mode / --registry-type / --registry-storage)
# ---------------------------------------------------------------------------
export MCP_SETUP_REGISTRY_MODE=bundled-https   # auto | bundled-http | bundled-https | external
# export MCP_REGISTRY_TYPE=docker              # docker (default); harbor coming soon
# export MCP_REGISTRY_STORAGE_SIZE=20Gi        # default: 20Gi

# External/provisioned registry — only needed for --registry-mode external
# export PROVISIONED_REGISTRY_URL=
# export PROVISIONED_REGISTRY_USERNAME=
# export PROVISIONED_REGISTRY_PASSWORD=

# ---------------------------------------------------------------------------
# Storage  (--storage-mode)
# ---------------------------------------------------------------------------
# export MCP_STORAGE_MODE=dynamic   # dynamic (default) | hostpath (single-node k3s/minikube/kind)

# ---------------------------------------------------------------------------
# Platform mode  (--platform-mode)
# ---------------------------------------------------------------------------
export MCP_SETUP_PLATFORM_MODE=tenant   # tenant (default) | org | public

# ---------------------------------------------------------------------------
# Ingress  (--ingress / --ingress-manifest / --force-ingress-install)
# ---------------------------------------------------------------------------
export MCP_SETUP_INGRESS=none           # traefik (default) | none
# export MCP_SETUP_INGRESS_MANIFEST=    # path to kustomize overlay; default derives from --with-tls
# export MCP_FORCE_INGRESS_INSTALL=1    # force repo-managed ingress even when IngressClass exists

# ---------------------------------------------------------------------------
# TLS  (--with-tls / --tls-cluster-issuer / --acme-email / --skip-cert-manager-install)
# ---------------------------------------------------------------------------
export MCP_SETUP_WITH_TLS=1
export MCP_SETUP_TLS_CLUSTER_ISSUER=letsencrypt-prod   # pre-existing ClusterIssuer; mutually exclusive with MCP_ACME_EMAIL
# Platform-wide workload PKI used for optional adapter client certificates on
# OAuth-protected server routes. Do not use Let's Encrypt for workload certs.
# Production enrollment requires both values; the bundled issuer can be selected
# with MCP_SETUP_MTLS_CLUSTER_ISSUER=mcp-runtime-ca when setup provisions it.
# export MCP_SETUP_MTLS_CLUSTER_ISSUER=company-workload-ca
# export MCP_TRUST_DOMAIN=mcpruntime.org
# export MCP_ACME_EMAIL=                                # Let's Encrypt contact; mutually exclusive with MCP_SETUP_TLS_CLUSTER_ISSUER
# export MCP_ACME_STAGING=1                             # use Let's Encrypt staging CA
export MCP_SETUP_SKIP_CERT_MANAGER_INSTALL=1            # set when cert-manager is already installed

# Optional production bundled MCP authorization server. Requires a real
# HTTPS issuer, an OIDC/OAuth connector file and selected connector. Setup
# provisions the issuer certificate from the configured TLS ClusterIssuer.
# export MCP_SETUP_WITH_MCP_AUTH_SERVER=1
# Defaults to https://auth.<MCP_PLATFORM_DOMAIN>/mcp-auth when unset.
# export MCP_SETUP_MCP_AUTH_ISSUER_URL=https://auth.mcpruntime.org/mcp-auth
# Optional override for an externally managed auth TLS Secret:
# export MCP_SETUP_MCP_AUTH_TLS_SECRET=mcp-auth-server-tls
# export MCP_SETUP_MCP_AUTH_SIGNING_KEY_SECRET=mcp-auth-signing-key
# The bundled MCP authorization server issuer above is separate from the
# platform's OAuth issuer configured below; each endpoint serves a different
# authorization server and route.
# The connector points from the bundled authorization server to an external
# identity provider such as Keycloak; it is not another Runtime gateway.
# export MCP_SETUP_MCP_AUTH_CONNECTORS_FILE=/secure/path/mcp-auth-connectors.json
# export MCP_SETUP_MCP_AUTH_CONNECTOR=keycloak

# ---------------------------------------------------------------------------
# Deployment behaviour  (--test-mode / --without-sentinel / --parallel-builds / --strict-prod)
# ---------------------------------------------------------------------------
# export MCP_SETUP_TEST_MODE=1        # local Kind/dev only — builds and pushes runtime images
# export MCP_WITHOUT_SENTINEL=1       # skip deploying the analytics stack
# export MCP_PARALLEL_BUILDS=1        # build setup images in parallel
# export MCP_STRICT_PROD=1            # require production-style registry + TLS validation

# ---------------------------------------------------------------------------
# Setup timing
# ---------------------------------------------------------------------------
export MCP_SETUP_WAIT_TIMEOUT=900
# export MCP_CERT_TIMEOUT=15m         # optional; extend cert-manager wait on first install

# ---------------------------------------------------------------------------
# Browser sign-in (required for public/tenant UI OIDC on setup)
# ---------------------------------------------------------------------------
# export GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# export MCP_GOOGLE_CLIENT_ID=...     # optional alias
# export OIDC_ISSUER=...              # optional non-Google provider
# export OIDC_AUDIENCE=...
# export OIDC_JWKS_URL=...

# ---------------------------------------------------------------------------
# MCP OAuth authorization server (MCPServer spec.auth)
# ---------------------------------------------------------------------------
# The ingress routes the OAuth server by PATH on the platform host -- there is
# no dedicated oauth. hostname (see internal/cli/setup/ingressmanifest/paths.go)
# -- so the issuer must keep the /oauth path component.
#
# Leave OAUTH_ISSUER_URL unset to let setup derive https://<platform host>/oauth.
# export OAUTH_ISSUER_URL=https://platform.mcpruntime.org/oauth
# Optional in-cluster transport URL for the external OAuth authorization server.
# export OAUTH_INTERNAL_ISSUER_URL=http://mcp-auth-server.mcp-platform.svc.cluster.local:8080
#
# Extra redirect_uri schemes to allow beyond https and http-loopback. Native MCP
# clients register a custom scheme; Cursor uses cursor://anysphere.cursor-mcp/
# oauth/callback. Comma-separated, scheme names only.
# export OAUTH_ALLOWED_REDIRECT_URI_SCHEMES=cursor
#
# Never set OAUTH_ALLOW_INSECURE_HTTP on a public deployment. It exists for
# local Kind only; with it unset, redirect URIs must be https or loopback.

# Optional bundled mcp-auth authorization server. Configure an external
# identity provider through the connector settings below.
# The default pulls princekrroshan01/mcp-auth-server:latest from Docker Hub.
# export MCP_SETUP_MCP_AUTH_SERVER_IMAGE=registry.example.org/mcp-auth-server:latest

# ---------------------------------------------------------------------------
# k3s-specific: use kube-system Traefik; do not patch repo-managed traefik
# ---------------------------------------------------------------------------
export PLATFORM_TEAM_TRAEFIK_WATCH=disabled
export PLATFORM_TRAEFIK_NAMESPACE=kube-system

# ---------------------------------------------------------------------------
# Platform-runtime backup (hack/deploy/mcpruntime-org/clean.sh)
# Preserves TLS, OIDC, bootstrap secrets across clean+setup. NOT tenant/user data.
# ---------------------------------------------------------------------------
# export MCP_TLS_BACKUP_DIR="$HOME/.mcpruntime/backups/mcpruntime-org"
# export MCP_RESTORE_TLS_AFTER_SETUP=1

# ---------------------------------------------------------------------------
# Rollout-only (hack/deploy/mcpruntime-org/rollout.sh)
# ---------------------------------------------------------------------------
# export MCP_ROLLOUT_TAG=verify-05252230

# ---------------------------------------------------------------------------
# Multitenancy test (hack/deploy/mcpruntime-org/multitenancy-test.sh — export at test time, not here)
# ---------------------------------------------------------------------------
# PLATFORM_URL=https://platform.mcpruntime.org
# MCP_URL=https://mcp.mcpruntime.org
# REGISTRY_HOST=registry.mcpruntime.org
