# One public hostname; replace example.com and use your own TLS/auth settings.
# Reuse this file on setup reruns so all public route choices remain explicit.
MCP_PLATFORM_INGRESS_HOST=mcp.example.com
MCP_REGISTRY_INGRESS_HOST=mcp.example.com
MCP_MCP_INGRESS_HOST=mcp.example.com
MCP_PLATFORM_PATH_PREFIX=/platform
MCP_REGISTRY_PATH=/registry
MCP_DOCS_PATH=/docs
MCP_DOCS_URL=https://mcpruntime.org/docs/
MCP_GRAFANA_PATH_PREFIX=/monitoring
# Used only when opting into the bundled authorization server. Configure its
# OIDC connector and durable signing key separately; retain existing external
# authorization servers and choose an unused issuer path when sharing a host.
MCP_SETUP_MCP_AUTH_ISSUER_URL=https://mcp.example.com/auth

# Only when HTTPS terminates on an external proxy and Traefik uses HTTP.
# Restrict origin access to the proxy and keep the public URL HTTPS.
# UI_REQUIRE_HTTPS=false
# UI_FORCE_SECURE_COOKIE=true
