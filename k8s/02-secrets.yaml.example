# Example credential Secrets for a static install.
# Do not commit real values. `mcp-runtime setup` generates these objects
# and keeps stored values on rerun. See docs/namespaces.md.
apiVersion: v1
kind: Secret
metadata:
  name: mcp-platform-api-credentials
  namespace: mcp-platform
type: Opaque
stringData:
  API_KEYS: "your-api-key-here,another-key-here"
  ADMIN_API_KEYS: "your-ui-key-here"
  UI_API_KEY: "your-ui-key-here"
  ADMIN_USERS: "admin@example.com"
  PLATFORM_ADMIN_EMAIL: "admin@example.com"
  PLATFORM_ADMIN_PASSWORD: "change-me-now"
  PLATFORM_DEV_LOGIN_ENABLED: "false"
  PLATFORM_DEV_USER_EMAIL: "test@mcpruntime.org"
  PLATFORM_DEV_USER_PASSWORD: "test@123"
  PLATFORM_DEV_ADMIN_EMAIL: "admin@mcpruntime.org"
  PLATFORM_DEV_ADMIN_PASSWORD: "admin@123"
  POSTGRES_DSN: "postgres://mcp_runtime:change-me-postgres@mcp-postgres.mcp-platform.svc.cluster.local:5432/mcp_runtime?sslmode=disable"
  JWT_SECRET: "replace-with-at-least-32-random-bytes"
  INTERNAL_AUTH_TOKEN: "replace-with-at-least-32-random-bytes"
---
apiVersion: v1
kind: Secret
metadata:
  name: mcp-ui-credentials
  namespace: mcp-platform
type: Opaque
stringData:
  UI_API_KEY: "your-ui-key-here"
  ADMIN_API_KEYS: "your-ui-key-here"
  UI_SESSION_DATABASE_URL: "postgres://mcp_runtime:change-me-postgres@mcp-postgres.mcp-platform.svc.cluster.local:5432/mcp_runtime?sslmode=disable"
  UI_SESSION_ENCRYPTION_KEY: "replace-with-at-least-32-random-bytes"
---
apiVersion: v1
kind: Secret
metadata:
  name: mcp-postgres-credentials
  namespace: mcp-platform
type: Opaque
stringData:
  POSTGRES_USER: "mcp_runtime"
  POSTGRES_PASSWORD: "change-me-postgres"
  POSTGRES_DB: "mcp_runtime"
---
apiVersion: v1
kind: Secret
metadata:
  name: mcp-ingest-credentials
  namespace: mcp-observability
type: Opaque
stringData:
  INGEST_API_KEYS: "your-ingest-key-here"
---
apiVersion: v1
kind: Secret
metadata:
  name: mcp-grafana-credentials
  namespace: mcp-observability
type: Opaque
stringData:
  GRAFANA_ADMIN_USER: "admin"
  GRAFANA_ADMIN_PASSWORD: "changeme"
